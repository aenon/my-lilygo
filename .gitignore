.pio/
.pioenvs/
.piolibdeps/
.vscode/
.idea/
.DS_Store
*.swp
build/

# Linked git worktrees (see AGENTS.md). Keep only this README tracked.
.worktrees/*
!.worktrees/README.md

# Vendor LilyGo repo is fetched on demand by scripts/bootstrap-vendor.sh —
# never commit it.
vendor/

# Per-app secrets (WiFi creds, API keys, etc.).  Only the templated
# secrets.example.h files are committed.
secrets.h
**/secrets.h

# Generated e-paper image data (built from images/ sources via
# scripts/svg-to-epaper.py).  Upload to LittleFS with `pio run -t uploadfs`.
data/
